{
  "name": "@psi-project-007/tlpass-crypto",
  "version": "0.1.0",
  "description": "Zero-knowledge crypto core for TLPass (pre-alpha, not audited).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "test:browser": "vitest run --browser.enabled",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm run lint && npm run coverage && npm run test:browser"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psi-project-007/tlpass-crypto.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/psi-project-007/tlpass-crypto/issues"
  },
  "homepage": "https://github.com/psi-project-007/tlpass-crypto#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  }
}
