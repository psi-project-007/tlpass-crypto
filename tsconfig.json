{
  "compilerOptions": {
    "target": "ES2022",            
    "module": "ESNext",            
    "moduleResolution": "Bundler", 
    "strict": true,                
    "declaration": true,           
    "outDir": "dist",              
    "skipLibCheck": true,          
    "noEmit": true,
    "resolveJsonModule": true,        
  },
  "include": ["src", "test", "*.config.ts"] 
}